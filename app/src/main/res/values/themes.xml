<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.MAK" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowBackground">@color/mak_paper</item>
        <!-- Splash screen: the poppy seed head on a white icon circle; the loading screen continues the animation. -->
        <item name="android:windowSplashScreenBackground">@color/mak_paper</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_logo_seed</item>
        <item name="android:windowSplashScreenIconBackgroundColor">@color/mak_paper</item>
        <item name="android:colorPrimary">@color/mak_accent</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>
</resources>
