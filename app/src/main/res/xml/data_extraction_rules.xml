<?xml version="1.0" encoding="utf-8"?>
<!--
   Android backup covers only the plan database and the user's settings (I-14).
   Rules are an allow-list, so any other file stays out of the backup by default:
   widget ids, scheduled alarm ids and future sync state belong to one device.
   Cloud backup runs only when it can be end-to-end encrypted (screen lock set).
-->
<data-extraction-rules>
    <cloud-backup disableIfNoEncryptionCapabilities="true">
        <include domain="database" path="mak.db" />
        <include domain="database" path="mak.db-wal" />
        <include domain="database" path="mak.db-shm" />
        <include domain="file" path="datastore/mak_settings.preferences_pb" />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="mak.db" />
        <include domain="database" path="mak.db-wal" />
        <include domain="database" path="mak.db-shm" />
        <include domain="file" path="datastore/mak_settings.preferences_pb" />
    </device-transfer>
</data-extraction-rules>
